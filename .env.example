# ==============================================================================
# WHATSAPP SAAS PLATFORM - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION (REQUIRED NOW)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BASE_URL=
RAILWAY_PUBLIC_DOMAIN=
SECRET_KEY_BASE=c7b56d98e4f1a23b98c7d6e5f4a3b2c1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5

# ------------------------------------------------------------------------------
# 2. WHATSAPP API CONFIGURATION (Server-Side YCloud / WhatsApp Provider)
# ------------------------------------------------------------------------------
YCLOUD_API_KEY=
YCLOUD_WEBHOOK_SECRET=
WHATSAPP_API_KEY=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta WhatsApp Business API & Embedded Signup
WABA_APP_ID=
WABA_APP_SECRET=
WABA_CONFIG_ID=
WABA_PHONE_NUMBER_ID=
WABA_BUSINESS_ACCOUNT_ID=
WABA_ACCESS_TOKEN=
WABA_VERIFY_TOKEN=waba_webhook_verify_token_secure_2026
WABA_API_VERSION=v21.0

# Meta App Credentials (for Webhook Signature Verification & Login)
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=waba_webhook_verify_token_secure_2026

# ------------------------------------------------------------------------------
# 3. EVOLUTION API (BAILEYS MULTI-DEVICE QR CODE ENGINE) (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
# If running external or local Evolution API instance
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
AUTHENTICATION_API_KEY=

# ------------------------------------------------------------------------------
# 4. CHATWOOT OMNICHANNEL INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (SERVER-SIDE LEAD QUALIFICATION & AUTO-REPLY)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
AI_MODEL_NAME=gemini-3.7-flash

# ------------------------------------------------------------------------------
# 6. FIREBASE CLOUD STORAGE / GOOGLE CLOUD STORAGE (MEDIA & AI KNOWLEDGE)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 7. PERSISTENCE & CACHE (PRODUCTION ONLY / OPTIONAL)
# ------------------------------------------------------------------------------
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 7. UNRELATED / THIRD-PARTY (NOT REQUIRED FOR MINIMUM WORKING STACK)
# ------------------------------------------------------------------------------
